#!/bin/sh
set -e
# users and their directories from mkosi.extra (sysusers.d, tmpfiles.d); systemd does not apply them at boot
systemd-sysusers
systemd-tmpfiles --create --prefix=/var/lib/openhu
# OpenHU is not in PATH: only openhu-session starts it (openhu-cli start | stop | restart), "openhu" would be
# mistaken for the command line openhu-cli. The package links /usr/bin/openhu to it.
[ -x /usr/libexec/openhu/openhu ] || { echo "openhu package without /usr/libexec/openhu/openhu (older than openhu#20)" >&2; exit 1; }
rm -f /usr/bin/openhu
systemctl set-default graphical.target
# Writes a random seed to the ESP on every boot: not needed by a head unit, and a write on every boot
systemctl mask systemd-boot-random-seed.service
# The splash stays until openhu-session takes the display over (plymouth quit --retain-splash); Plymouth's own quit
# at the end of the boot would leave a black screen in between
systemctl mask plymouth-quit.service plymouth-quit-wait.service
# NetworkManager ignores profiles that others can read (git only knows 0644)
chmod 600 /usr/lib/NetworkManager/system-connections/*.nmconnection
# /etc is read-only: NetworkManager writes resolv.conf to /run
ln -sf ../run/NetworkManager/resolv.conf /etc/resolv.conf
# Every device creates its own ssh host keys on the data partition (/usr/libexec/openhu-os/ssh-hostkeys), not the
# ones the package generated while the image was built
rm -f /etc/ssh/ssh_host_*
# ssh: root's password from the data partition (openhu-ssh password), before the image's own accounts
sed -i 's|^@include common-auth|auth sufficient pam_pwdfile.so pwdfile=/var/lib/openhu-os/ssh/passwd\n@include common-auth|' /etc/pam.d/sshd
grep -q pam_pwdfile /etc/pam.d/sshd
# The system's name in the boot menu (systemd-boot reads it from the unified kernel image), at the login and in
# hostnamectl. ID=debian and VERSION_ID stay for tools that check for Debian.
debian="$(. /usr/lib/os-release && echo "Debian $VERSION_ID $VERSION_CODENAME")"
sed -i -e "s|^PRETTY_NAME=.*|PRETTY_NAME=\"OpenHU OS $IMAGE_VERSION ($debian)\"|" \
       -e 's|^NAME=.*|NAME="OpenHU OS"|' \
       -e 's|^HOME_URL=.*|HOME_URL="https://github.com/average-web-dev/openhu-os"|' \
       -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/average-web-dev/openhu-os"|' \
       -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/average-web-dev/openhu-os/issues"|' \
       /usr/lib/os-release
# Raspberry Pi image (#39): IMAGE_ID stays openhu-os, the board is the variant
if [ "$ARCHITECTURE" = arm64 ]; then
  printf 'VARIANT="Raspberry Pi"\nVARIANT_ID=rpi\n' >> /usr/lib/os-release
fi
printf 'OpenHU OS %s \\n \\l\n\n' "$IMAGE_VERSION" > /etc/issue
printf 'OpenHU OS %s\n' "$IMAGE_VERSION" > /etc/issue.net
# Login greeting: /etc/update-motd.d/10-openhu-os instead of Debian's uname line (/etc/motd is empty, mkosi.extra)
rm -f /etc/update-motd.d/10-uname
