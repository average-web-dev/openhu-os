#!/usr/bin/python3
"""A/B update of OpenHU OS.

  openhu-update [status] [--json]               running version, both root slots, boot entries, update state
  openhu-update check [--json]                  newest version on the USB sticks and the update server
  openhu-update update [--version V] [--reboot] install in the foreground (console)
  openhu-update start [--version V] [--json]    install in the background as openhu-update.service (OpenHU)
  openhu-update cancel [--json]                 stop the background update; the running version stays
  openhu-update scan [--json]                   look at the USB sticks, write /run/openhu-os/usb-update.json

OpenHU runs it as the openhu user with pkexec (polkit allows this program). The state of an update is in
/run/openhu-os/update.json, readable without root: {"state": "checking" | "installing" | "done" | "uptodate" |
"error" | "cancelled", "from", "version", "phase": "root" | "kernel", "percent" (0-100 over both), "error"}.

The update server is a directory with SHA256SUMS, openhu-os_<version>.root.raw.gz (root partition) and
openhu-os_<version>.efi (unified kernel image), see scripts/add-update.sh. The Raspberry Pi image (VARIANT_ID=rpi in
os-release) takes openhu-os-rpi_<version>.root.raw.gz and openhu-os-rpi_<version>.boot.raw.gz (its boot partition)
instead. Its URL: OPENHU_UPDATE_URL, else URL= in
/var/lib/openhu-os/update.conf, else in /usr/lib/openhu-os/update.conf.

A USB stick is a second source: the same files, in the stick's top folder, in openhu-os/ or in a folder below
openhu-os/ (several versions on one stick). openhu-usb@.service mounts sticks read-only under /run/media/<name> and
runs "scan" when one comes or goes; /run/openhu-os/usb-update.json then has the newest version on the sticks:
{"current", "version" (null without one), "newer", "path"}. The newest version of both sources wins, the stick on a
tie (nothing to download).

An update goes into the root slot that is not running, in an order that a power cut at any moment leaves the
running version bootable:
  1. remove the boot entry of the version in the other slot, relabel the slot "_empty"
  2. write and verify the root partition, relabel the slot "openhu_<version>"
  3. write and verify the unified kernel image as EFI/Linux/openhu-os_<version>+3.efi
systemd-boot boots the newest version first and counts its tries. openhu-boot-check.service marks it good when
OpenHU answers; after three failed tries systemd-boot boots the version before again.

On the Raspberry Pi (#39) the other slot is a boot partition and a root partition, and steps 1 and 3 are:
  1. relabel the other boot partition "_empty", then its root slot
  3. write and verify the boot partition, relabel it "openhu-boot_<version>+3", then arm the first try
/usr/libexec/openhu-os/tryboot counts the tries in that label and boots it with the firmware's tryboot; the next
reboot (also a power cut: the running version starts it) tries the new version, openhu-tryboot-check.service keeps
it when OpenHU answers.
"""
import fcntl
import gzip
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

IMAGE_ID = "openhu-os"
ESP = "/boot"
UKI_DIR = ESP + "/EFI/Linux"
EMPTY_LABEL = "_empty"
SLOT_PREFIX = "openhu_"  # root slot label: openhu_<version>
ROOT_TYPES = {
    "4f68bce3-e8cd-4db1-96e7-fbcaf984b709",  # root x86-64
    "b921b045-1df0-41c3-af44-4c6f280d3fae",  # root arm64
}
CONFIGS = ["/var/lib/openhu-os/update.conf", "/usr/lib/openhu-os/update.conf"]
MEDIA = "/run/media"
USB_STATE = "/run/openhu-os/usb-update.json"
LOADER_GUID = "4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"
CHUNK = 1 << 20
STATE = "/run/openhu-os/update.json"
UNIT = "openhu-update.service"
# share of the root partition in the overall percent (it is about 90 % of the download)
ROOT_SHARE = 90
TRYBOOT = "/usr/libexec/openhu-os/tryboot"


def os_release(key):
    with open("/usr/lib/os-release") as f:
        for line in f:
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip().strip('"')
    return None


# Raspberry Pi image (#39): its update files are openhu-os-rpi_<version>.*, the second one is the boot partition
RPI = os_release("VARIANT_ID") == "rpi"
NAME = "openhu-os-rpi" if RPI else IMAGE_ID
BOOT_FILE = ".boot.raw.gz" if RPI else ".efi"

JSON = False


class UpdateError(Exception):
    pass


class Cancelled(Exception):
    pass


def fail(message):
    raise UpdateError(message)


def write_json(path, data):
    """Atomically, readable by everyone (OpenHU)"""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temp = path + ".new"
    with open(temp, "w") as f:
        json.dump(data, f)
    os.chmod(temp, 0o644)
    os.rename(temp, path)


def report(**fields):
    """Writes the update state for OpenHU"""
    write_json(STATE, fields)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return {}


def read_state():
    return read_json(STATE) or {"state": "idle"}


def output(data, text):
    print(json.dumps(data) if JSON else text)


def version_key(version):
    """2026.10.12.1007 < 2026.10.12.1100; numbers compare as numbers"""
    return [(0, int(part), "") if part.isdigit() else (1, 0, part) for part in re.split(r"[.~-]", version)]


def running_version():
    return os_release("IMAGE_VERSION") or fail("no IMAGE_VERSION in /usr/lib/os-release")


def load_tryboot():
    """The Pi's boot helper as a module (partitions, labels, tries)"""
    loader = importlib.machinery.SourceFileLoader("tryboot", TRYBOOT)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("tryboot", loader))
    loader.exec_module(module)
    return module


def server_url():
    if os.environ.get("OPENHU_UPDATE_URL"):
        return os.environ["OPENHU_UPDATE_URL"]
    for path in CONFIGS:
        try:
            with open(path) as f:
                for line in f:
                    if line.startswith("URL=") and line.split("=", 1)[1].strip():
                        return line.split("=", 1)[1].strip()
        except FileNotFoundError:
            pass
    fail("no update server: URL= in /var/lib/openhu-os/update.conf")


def efi_var(name):
    try:
        with open(f"/sys/firmware/efi/efivars/{name}-{LOADER_GUID}", "rb") as f:
            return f.read()[4:].decode("utf-16-le").rstrip("\0")
    except FileNotFoundError:
        return None


# --- disk ---

def lsblk(*args):
    out = subprocess.run(["lsblk", "--json", "--bytes", "-o", "PATH,PKNAME,PARTN,PARTTYPE,PARTLABEL,SIZE", *args],
                         check=True, capture_output=True, text=True).stdout
    return json.loads(out)["blockdevices"]


def slots():
    """(running slot, other slot) as lsblk entries"""
    source = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "/"], check=True, capture_output=True,
                            text=True).stdout.strip()
    running = lsblk("--nodeps", os.path.realpath(source))[0]
    disk = "/dev/" + running["pkname"]
    roots = [p for p in lsblk(disk) if (p.get("parttype") or "").lower() in ROOT_TYPES]
    others = [p for p in roots if p["path"] != running["path"]]
    if len(others) != 1:
        fail(f"expected two root slots on {disk}, found {len(roots)}")
    return running, others[0], disk


def set_label(disk, partition, label):
    # the kernel keeps its partition table while the disk is in use ("Re-reading the partition table failed"):
    # the label is on the disk, that is enough
    result = subprocess.run(["sfdisk", "--quiet", "--part-label", disk, str(partition["partn"]), label],
                            capture_output=True, text=True)
    if result.returncode != 0:
        fail(f"sfdisk: {result.stderr.strip()}")
    os.sync()
    # udev (lsblk, /dev/disk/by-partlabel) learns the new label
    subprocess.run(["udevadm", "trigger", "--action=change", "--settle", partition["path"]], check=False)


def slot_version(partition):
    label = partition.get("partlabel") or ""
    return label[len(SLOT_PREFIX):] if label.startswith(SLOT_PREFIX) else None


# --- boot entries ---

UKI_RE = re.compile(rf"^{re.escape(IMAGE_ID)}_(?P<version>[^+]+?)(\+(?P<left>\d+)(-(?P<done>\d+))?)?\.efi$")


def boot_entries():
    """{file name: (version, tries left or None)}"""
    entries = {}
    for name in sorted(os.listdir(UKI_DIR)):
        match = UKI_RE.match(name)
        if match:
            left = match.group("left")
            entries[name] = (match.group("version"), int(left) if left is not None else None)
    return entries


def remove_entries(version):
    for name, (entry_version, _) in boot_entries().items():
        if entry_version == version:
            os.remove(os.path.join(UKI_DIR, name))
    for name in os.listdir(UKI_DIR):
        if name.startswith("."):  # half written by an interrupted update
            os.remove(os.path.join(UKI_DIR, name))
    os.sync()


# --- server ---

def fetch(url):
    return urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "openhu-update"}), timeout=30)


def available(base):
    """{version: {file name: sha256}} with both files of a version of this image (x86 or Pi)"""
    with fetch(urllib.parse.urljoin(base, "SHA256SUMS")) as response:
        sums = {}
        for line in response.read().decode().splitlines():
            parts = line.split()
            if len(parts) == 2:
                sums[parts[1].lstrip("*")] = parts[0].lower()
    versions = {}
    for name in sums:
        match = re.match(rf"^{re.escape(NAME)}_(.+)\.root\.raw\.gz$", name)
        if match and f"{NAME}_{match.group(1)}{BOOT_FILE}" in sums:
            version = match.group(1)
            versions[version] = {n: sums[n] for n in (f"{NAME}_{version}{BOOT_FILE}",
                                                       f"{NAME}_{version}.root.raw.gz")}
    return versions


def stick_folders():
    """Folders on the mounted USB sticks with a SHA256SUMS: the top folder, openhu-os/ and the folders in it"""
    folders = []
    try:
        mounts = sorted(os.listdir(MEDIA))
    except FileNotFoundError:
        return folders
    for name in mounts:
        top = os.path.join(MEDIA, name)
        if not os.path.ismount(top):
            continue
        candidates = [top, os.path.join(top, "openhu-os")]
        try:
            candidates += sorted(e.path for e in os.scandir(candidates[1]) if e.is_dir())
        except OSError:
            pass
        folders += [c for c in candidates if os.path.isfile(os.path.join(c, "SHA256SUMS"))]
    return folders


def from_sticks():
    """{version: (source, base URL, files)} of every version on the sticks; a stick that cannot be read is skipped"""
    versions = {}
    for folder in stick_folders():
        base = "file://" + urllib.parse.quote(folder) + "/"
        try:
            found = available(base)
        except (OSError, urllib.error.URLError, UnicodeDecodeError):
            continue
        for version, files in found.items():
            # both files must be there, not only listed
            if all(os.path.isfile(os.path.join(folder, n)) for n in files):
                versions.setdefault(version, ("usb", base, files))
    return versions


def sources():
    """{version: (source, base URL, files)} of the sticks and the update server; the stick wins a tie.
    The server's error only counts without a stick: (versions, error of the server or None)"""
    versions = from_sticks()
    try:
        base = server_url()
        for version, files in available(base).items():
            versions.setdefault(version, ("online", base, files))
        return versions, None
    except (UpdateError, OSError, urllib.error.URLError) as e:
        message = f"update server: {e.reason}" if isinstance(e, urllib.error.URLError) else str(e)
        if not versions:
            raise UpdateError(message) from e
        return versions, message


class Progress:
    """Prints every 10 % and writes every 1 % of the overall progress to the state file"""

    def __init__(self, phase, total, start, share, fields):
        self.phase, self.total, self.start, self.share, self.fields = phase, total, start, share, fields
        self.done, self.shown = 0, -1

    def add(self, n):
        self.done += n
        if not self.total:
            return
        percent = self.start + min(self.done, self.total) * self.share // self.total
        if percent != self.shown:
            if percent // 10 != self.shown // 10 and not JSON:
                print(f"  {percent} %", flush=True)
            self.shown = percent
            report(**self.fields, state="installing", phase=self.phase, percent=percent)


class HashingReader:
    """Reads from a response, hashes and counts what was read (the compressed download)"""

    def __init__(self, response, progress):
        self.response, self.progress, self.sha = response, progress, hashlib.sha256()

    def read(self, n=-1):
        data = self.response.read(n)
        self.sha.update(data)
        self.progress.add(len(data))
        return data


def write_partition(url, sha256, device, size, fields, phase="root", start=0, share=ROOT_SHARE, what="root partition"):
    """A compressed partition image into a partition, checked against its SHA-256"""
    with fetch(url) as response:
        total = int(response.headers.get("Content-Length") or 0)
        reader = HashingReader(response, Progress(phase, total, start, share, fields))
        fd = os.open(device, os.O_WRONLY | os.O_CLOEXEC)
        try:
            written = 0
            with gzip.GzipFile(fileobj=reader) as image:
                while chunk := image.read(CHUNK):
                    written += len(chunk)
                    if written > size:
                        fail(f"{what} image larger than the partition ({size} bytes)")
                    os.write(fd, chunk)
            while reader.read(CHUNK):  # trailing data still counts for the checksum
                pass
            os.fsync(fd)
        finally:
            os.close(fd)
    if reader.sha.hexdigest() != sha256:
        fail(f"{what}: checksum mismatch, the slot stays empty")


def write_uki(url, sha256, version, fields):
    temp = os.path.join(UKI_DIR, f".{IMAGE_ID}_{version}.efi.part")
    sha = hashlib.sha256()
    with fetch(url) as response, open(temp, "wb") as f:
        total = int(response.headers.get("Content-Length") or 0)
        progress = Progress("kernel", total, ROOT_SHARE, 100 - ROOT_SHARE, fields)
        while chunk := response.read(CHUNK):
            sha.update(chunk)
            f.write(chunk)
            progress.add(len(chunk))
        f.flush()
        os.fsync(f.fileno())
    if sha.hexdigest() != sha256:
        os.remove(temp)
        fail("kernel image: checksum mismatch")
    # three tries, counted by systemd-boot; openhu-boot-check.service removes the counter
    os.rename(temp, os.path.join(UKI_DIR, f"{IMAGE_ID}_{version}+3.efi"))
    os.sync()


# --- commands ---

def unit_active():
    return subprocess.run(["systemctl", "is-active", "--quiet", UNIT]).returncode == 0


def status():
    running, other, _ = slots()
    entries = []
    if RPI:
        # the boot partitions, "file" is the partition's label
        boot = "boot partition " + ", ".join(e["partition"] for e in load_tryboot().status() if e["running"])
        for e in load_tryboot().status():
            if e["version"] is not None:
                entries.append({"file": e["label"], "version": e["version"], "state": e["state"],
                                "tries_left": e["tries_left"]})
    else:
        boot = f"boot entry {efi_var('LoaderEntrySelected')}"
        for name, (version, left) in boot_entries().items():
            entries.append({"file": name, "version": version,
                            "state": "good" if left is None else ("trying" if left > 0 else "failed"),
                            "tries_left": left})
    state = read_state()
    if state.get("state") in ("checking", "installing") and not unit_active():
        state = {"state": "idle"}  # left over from an update that ended with the power
    usb = read_json(USB_STATE)
    data = {"running": running_version(), "slot": running["path"], "other": slot_version(other),
            "other_slot": other["path"], "entries": entries, "update": state, "active": unit_active(), "usb": usb}
    lines = [f"running:    {data['running']} ({running['path']}, {boot})",
             f"other slot: {data['other'] or 'empty'} ({other['path']})"]
    for entry in entries:
        left = entry["tries_left"]
        lines.append(f"  {entry['file']}: " + ("good" if left is None else f"{left} tries left" if left else "failed"))
    if data["active"] or state.get("state") not in (None, "idle"):
        lines.append(f"update: {json.dumps(state)}")
    if usb.get("version"):
        lines.append(f"USB stick: {usb['version']} ({usb['path']})")
    output(data, "\n".join(lines))


def check():
    current = running_version()
    versions, server_error = sources()
    newest = max(versions, key=version_key, default=None)
    newer = bool(newest) and version_key(newest) > version_key(current)
    source = versions[newest][0] if newest else None
    data = {"current": current, "newest": newest, "available": newer, "source": source}
    if server_error:
        data["server_error"] = server_error
    output(data, (f"update available: {current} -> {newest} ({'USB stick' if source == 'usb' else 'online'})"
                  if newer else f"up to date: {current}") + (f"\n({server_error})" if server_error else ""))


def scan():
    """The newest version on the USB sticks for OpenHU (usb-update.json), run by openhu-usb@.service"""
    current = running_version()
    versions = from_sticks()
    newest = max(versions, key=version_key, default=None)
    path = urllib.parse.unquote(urllib.parse.urlparse(versions[newest][1]).path).rstrip("/") if newest else None
    data = {"current": current, "version": newest, "path": path,
            "newer": bool(newest) and version_key(newest) > version_key(current)}
    write_json(USB_STATE, data)
    output(data, f"USB stick: {newest} ({path})" if newest else "no update on a USB stick")


def start(version=None):
    if unit_active():
        fail("an update is already running")
    report(state="checking", **({"version": version} if version else {}))
    command = ["systemd-run", f"--unit={UNIT}", "--collect", "--quiet", "--description=OpenHU OS update"]
    if os.environ.get("OPENHU_UPDATE_URL"):  # the service does not inherit the environment
        command.append(f"--setenv=OPENHU_UPDATE_URL={os.environ['OPENHU_UPDATE_URL']}")
    command += ["/usr/libexec/openhu-os/openhu-update", "update"] + (["--version", version] if version else [])
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        report(state="error", error=result.stderr.strip())
        fail(f"systemd-run: {result.stderr.strip()}")
    output({"started": True}, f"update started ({UNIT}), progress: {STATE}")


def cancel():
    was_active = unit_active()
    subprocess.run(["systemctl", "stop", UNIT], check=False)
    output({"cancelled": was_active}, "update cancelled" if was_active else "no update running")


def update(version=None, reboot=False):
    lock = open("/run/openhu-update.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail("another update is running")

    def on_term(signum, frame):
        raise Cancelled()
    signal.signal(signal.SIGTERM, on_term)

    report(state="checking")
    current = running_version()
    versions, _ = sources()
    if version is None:
        version = max(versions, key=version_key, default=None)
        if version is None or version_key(version) <= version_key(current):
            report(state="uptodate", version=current)
            output({"state": "uptodate", "version": current}, f"up to date: {current}")
            return
    if version not in versions:
        fail(f"version {version} is neither on a USB stick nor on the update server")
    if version == current:
        fail(f"version {version} is running")

    running, other, disk = slots()
    tryboot = load_tryboot() if RPI else None
    if not RPI and not os.path.isdir(UKI_DIR):
        fail(f"{UKI_DIR} not found (ESP not mounted?)")
    source, base, files = versions[version]
    fields = {"from": current, "version": version, "source": source}
    report(**fields, state="installing", phase="root", percent=0)
    if not JSON:
        print(f"update {current} -> {version} into {other['path']}" + (" from the USB stick" if source == "usb" else ""))

    labelled = False
    other_boot = None
    errors = (Cancelled, UpdateError, OSError, EOFError, urllib.error.URLError)
    try:
        # 1. the other slot's version can no longer boot, then its slot is free
        old = slot_version(other)
        if RPI:
            _, _, _, other_boot = tryboot.partitions()
            tryboot.boot_label(version)  # fits into a partition name
            tryboot.set_label(disk, other_boot, EMPTY_LABEL)
        elif old:
            remove_entries(old)
        set_label(disk, other, EMPTY_LABEL)

        # 2. root partition, labelled only once it is complete
        write_partition(urllib.parse.urljoin(base, f"{NAME}_{version}.root.raw.gz"),
                        files[f"{NAME}_{version}.root.raw.gz"], other["path"], other["size"], fields)
        set_label(disk, other, SLOT_PREFIX + version)
        labelled = True

        # 3. boot entry: from now on systemd-boot tries the new version first; on the Pi the boot partition with
        # its tries in the label, and the first try armed: the next reboot boots it
        if RPI:
            write_partition(urllib.parse.urljoin(base, f"{NAME}_{version}.boot.raw.gz"),
                            files[f"{NAME}_{version}.boot.raw.gz"], other_boot["path"], other_boot["size"], fields,
                            phase="kernel", start=ROOT_SHARE, share=100 - ROOT_SHARE, what="boot partition")
            tryboot.set_label(disk, other_boot, tryboot.boot_label(version, tryboot.TRIES))
            tryboot.arm()
        else:
            write_uki(urllib.parse.urljoin(base, f"{IMAGE_ID}_{version}.efi"), files[f"{IMAGE_ID}_{version}.efi"],
                      version, fields)
    except errors + ((tryboot.TrybootError,) if RPI else ()) as e:
        # the slot without a boot entry: empty again, so nothing shows a version that cannot boot
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        if labelled:
            set_label(disk, other, EMPTY_LABEL)
        if RPI:
            if other_boot is not None:
                tryboot.set_label(disk, other_boot, EMPTY_LABEL)
        else:
            remove_entries(version)
        if isinstance(e, Cancelled):
            report(**fields, state="cancelled")
            raise
        if source == "usb" and not os.path.isdir(urllib.parse.unquote(urllib.parse.urlparse(base).path)):
            raise UpdateError("the USB stick was removed, the update was not installed") from e
        raise UpdateError(str(e)) from e

    report(**fields, state="done", percent=100)
    output({**fields, "state": "done"},
           f"version {version} installed, active after a reboot (3 tries, then back to {current})")
    if reboot:
        subprocess.run(["systemctl", "reboot"], check=True)


def versions_of(state):
    return {k: v for k, v in state.items() if k in ("from", "version", "source")}


def option(args, name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


def main(args):
    global JSON
    JSON = "--json" in args
    args = [a for a in args if a != "--json"]
    command = args[0] if args else "status"
    try:
        if os.geteuid() != 0:
            fail("needs root (pkexec)")
        if command == "status":
            status()
        elif command == "check":
            check()
        elif command == "update":
            try:
                update(option(args, "--version"), reboot="--reboot" in args)
            except Cancelled:
                report(**versions_of(read_state()), state="cancelled")
                raise
            except (UpdateError, OSError, urllib.error.URLError) as e:
                message = f"update server: {e.reason}" if isinstance(e, urllib.error.URLError) else str(e)
                report(**versions_of(read_state()), state="error", error=message)
                raise UpdateError(message) from e
        elif command == "start":
            start(option(args, "--version"))
        elif command == "cancel":
            cancel()
        elif command == "scan":
            scan()
        else:
            sys.exit(__doc__)
    except urllib.error.URLError as e:
        error(f"update server: {e.reason}")
    except UpdateError as e:
        error(str(e))
    except Cancelled:
        error("cancelled")


def error(message):
    if JSON:
        print(json.dumps({"error": message}))
    else:
        print(f"openhu-update: {message}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
