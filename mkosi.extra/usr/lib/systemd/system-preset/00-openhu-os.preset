# Everything not listed here stays disabled (mkosi runs systemctl preset-all)
enable NetworkManager.service
enable bluetooth.service
enable systemd-timesyncd.service
enable openhu-session.service
enable openhu-boot-check.service
enable openhu-boot-status.service
# Raspberry Pi only (rpi/extra): the boot check of a version tried with tryboot
enable openhu-tryboot-check.service
# only starts when switched on (openhu-ssh), see ssh.service.d/openhu-os.conf
enable ssh.service
enable fstrim.timer
# Ethernet (#15): no forwarding for the devices, openhu.local
enable openhu-ethernet-firewall.service
enable avahi-daemon.service
enable avahi-daemon.socket
# keymap of the text consoles (#35)
enable openhu-console-keymap.service
disable *
